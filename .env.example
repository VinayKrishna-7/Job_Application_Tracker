# EasyTrack Environment Variables Example

# Server Environment
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/easytrack

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration (Optional - falls back to local storage if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client Environment (Vite)
VITE_API_URL=http://localhost:5000/api
