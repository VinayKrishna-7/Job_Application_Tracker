NODE_ENV=development
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/easytrack

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional - file upload falls back to local storage if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
